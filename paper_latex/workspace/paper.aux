\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces FOLIO benchmark results (n=204, Llama-3.1-8B generator). All pairwise McNemar tests are non-significant after Benjamini-Hochberg correction ($p_{\text  {adj}} = 0.77$ for all pairs; Cohen's $h \leq 0.14$).}}{6}{table.1}\protected@file@percent }
\newlabel{tab:folio}{{1}{6}{FOLIO benchmark results (n=204, Llama-3.1-8B generator). All pairwise McNemar tests are non-significant after Benjamini-Hochberg correction ($p_{\text {adj}} = 0.77$ for all pairs; Cohen's $h \leq 0.14$)}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Downstream inference accuracy on 204 FOLIO validation examples for all seven conditions, with 95\% bootstrap confidence intervals (10,000 resamples). All pairwise McNemar tests are non-significant after Benjamini-Hochberg correction ($p_{\text  {adj}} = 0.77$ for all pairs; Cohen's $h \leq 0.14$). The 38\% beam recall ceiling (dashed orange line) sets the maximum achievable accuracy for any selection strategy.}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:results}{{2}{7}{Downstream inference accuracy on 204 FOLIO validation examples for all seven conditions, with 95\% bootstrap confidence intervals (10,000 resamples). All pairwise McNemar tests are non-significant after Benjamini-Hochberg correction ($p_{\text {adj}} = 0.77$ for all pairs; Cohen's $h \leq 0.14$). The 38\% beam recall ceiling (dashed orange line) sets the maximum achievable accuracy for any selection strategy}{figure.2}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {4.1.5}Discriminative Signal Analysis}{7}{subsubsection.4.1.5}\protected@file@percent }
\newlabel{sec:exp1-signal}{{4.1.5}{7}{Discriminative Signal Analysis}{subsubsection.4.1.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Left:} Accuracy on the synthetic single-premise NLI benchmark (n=100, Llama-3.1-70B generator, 100\% beam recall). Direct oracle judgment (99\%) outperforms all HOWP variants (93\%) and baselines (94\%), because 33\% oracle noise hurts world-probing selection on simple sentences. \textbf  {Right:} On FOLIO (n=204), the maximum cross-world agreement score among candidates has AUC-ROC $= 0.660$ and Kendall $\tau = 0.212$ ($p = 0.0009$) for predicting per-example correctness, confirming the mechanism's discriminative signal despite the beam recall ceiling.}}{8}{figure.3}\protected@file@percent }
\newlabel{fig:synthetic}{{3}{8}{\textbf {Left:} Accuracy on the synthetic single-premise NLI benchmark (n=100, Llama-3.1-70B generator, 100\% beam recall). Direct oracle judgment (99\%) outperforms all HOWP variants (93\%) and baselines (94\%), because 33\% oracle noise hurts world-probing selection on simple sentences. \textbf {Right:} On FOLIO (n=204), the maximum cross-world agreement score among candidates has AUC-ROC $= 0.660$ and Kendall $\tau = 0.212$ ($p = 0.0009$) for predicting per-example correctness, confirming the mechanism's discriminative signal despite the beam recall ceiling}{figure.3}{}}
